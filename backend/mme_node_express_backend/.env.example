PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=make_my_event_office_management
# Optional. Only needed in production, where Accounts/backend isn't at the
# same repo-relative path as in local dev - see deploy.yml. Leave unset
# locally.
# ACCOUNTS_BACKEND_DIR=/home/datapulseglobal/mme-office-app/accounts-module
# BACKEND_SRC_DIR=/home/datapulseglobal/mme-office-app/src
# Optional. Same idea as ACCOUNTS_BACKEND_DIR/STORAGE_DIR above, for the PDF
# Generator module. Leave unset locally.
# PDF_GENERATOR_BACKEND_DIR=/home/datapulseglobal/mme-office-app/pdf-generator-module
# PDF_GENERATOR_STORAGE_DIR=/home/datapulseglobal/mme-office-data/pdf-generator
# PDF_GENERATOR_TEMPLATE_PATH=/home/datapulseglobal/mme-office-app/pdf-generator-module/templates/make-my-event-letter-pad.pdf

# Optional. Same idea as PDF_GENERATOR_* above, for the (Admin-only) Money
# Receipt Generator module. Leave unset locally. MONEY_RECEIPT_TEMPLATE_PATH
# only needs setting if you want to override the module's own bundled
# letterhead template (MoneyReceiptGenerator/backend/templates/make-my-event-letter-pad.pdf).
# MONEY_RECEIPT_BACKEND_DIR=/home/datapulseglobal/mme-office-app/money-receipt-module
# MONEY_RECEIPT_STORAGE_DIR=/home/datapulseglobal/mme-office-data/money-receipts
# MONEY_RECEIPT_TEMPLATE_PATH=/home/datapulseglobal/mme-office-app/money-receipt-module/templates/make-my-event-letter-pad.pdf

