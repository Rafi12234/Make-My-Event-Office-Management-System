generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  Admin
  Employee
}

enum AccountCostType {
  event
  regular
}

enum AccountEntrySource {
  employee
  admin
}

enum AccountPaymentSource {
  employee_wallet
  company
}

enum AccountRecordStatus {
  active
  void
}

enum VendorPaymentStatus {
  to_pay
  paid
}

model Role {
  id        Int       @id @default(autoincrement()) @db.UnsignedTinyInt
  name      RoleName
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  employees Employee[]

  @@map("roles")
}

model Employee {
  id       BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  fullName String   @map("full_name") @db.VarChar(150)
  email    String   @unique @db.VarChar(190)
  roleId   Int?     @map("role_id") @db.UnsignedTinyInt
  isActive Boolean? @default(true) @map("is_active")

  role Role? @relation(fields: [roleId], references: [id])

  wallet                 AccountWallet?
  moneyReceived          AccountMoneyReceived[] @relation("MoneyReceivedEmployee")
  moneyReceivedCreated   AccountMoneyReceived[] @relation("MoneyReceivedCreatedByAdmin")
  expenses               AccountExpense[]       @relation("ExpenseEmployee")
  expensesCreatedByAdmin AccountExpense[]       @relation("ExpenseCreatedByAdmin")
  expensesVoidedByAdmin  AccountExpense[]       @relation("ExpenseVoidedByAdmin")
  expensesApprovedByAdmin AccountExpense[]      @relation("ExpenseApprovedByAdmin")

  @@map("employees")
}

model AccountWallet {
  employeeId     BigInt   @id @map("employee_id") @db.UnsignedBigInt
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(12, 2)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("account_wallets")
}

model AccountMoneyReceived {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  employeeId       BigInt?            @map("employee_id") @db.UnsignedBigInt
  amount           Decimal            @db.Decimal(12, 2)
  receivedDate     DateTime           @map("received_date") @db.Date
  note             String?            @db.VarChar(255)
  source           AccountEntrySource @default(employee)
  createdByAdminId BigInt?            @map("created_by_admin_id") @db.UnsignedBigInt
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  employee       Employee? @relation("MoneyReceivedEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  createdByAdmin Employee? @relation("MoneyReceivedCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([employeeId], map: "fk_account_money_received_employee")
  @@index([createdByAdminId], map: "fk_account_money_received_created_admin")
  @@index([receivedDate], map: "idx_account_money_received_date")
  @@map("account_money_received")
}

model AccountExpense {
  id                      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  employeeId              BigInt?              @map("employee_id") @db.UnsignedBigInt
  costType                AccountCostType      @map("cost_type")
  linkedRowKey            String?              @map("linked_row_key") @db.Char(36)
  eventClientNameSnapshot String?              @map("event_client_name_snapshot") @db.VarChar(190)
  eventDateSnapshot       DateTime?            @map("event_date_snapshot") @db.Date
  totalAmount             Decimal              @map("total_amount") @db.Decimal(12, 2)
  walletDeductionAmount   Decimal              @default(0) @map("wallet_deduction_amount") @db.Decimal(12, 2)
  paymentSource           AccountPaymentSource @default(employee_wallet) @map("payment_source")
  createdByAdminId        BigInt?              @map("created_by_admin_id") @db.UnsignedBigInt
  status                  AccountRecordStatus  @default(active)
  voidReason              String?              @map("void_reason") @db.VarChar(255)
  voidedByAdminId         BigInt?              @map("voided_by_admin_id") @db.UnsignedBigInt
  voidedAt                DateTime?            @map("voided_at") @db.DateTime(0)
  approved                Boolean              @default(false)
  approvedByAdminId       BigInt?              @map("approved_by_admin_id") @db.UnsignedBigInt
  approvedAt              DateTime?            @map("approved_at") @db.DateTime(0)
  createdAt               DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  employee        Employee? @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  createdByAdmin  Employee? @relation("ExpenseCreatedByAdmin", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  voidedByAdmin   Employee? @relation("ExpenseVoidedByAdmin", fields: [voidedByAdminId], references: [id], onDelete: SetNull)
  approvedByAdmin Employee? @relation("ExpenseApprovedByAdmin", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  items           AccountExpenseItem[]

  @@index([employeeId], map: "fk_account_expenses_employee")
  @@index([linkedRowKey], map: "idx_account_expenses_row")
  @@index([createdByAdminId], map: "fk_account_expenses_created_admin")
  @@index([voidedByAdminId], map: "fk_account_expenses_voided_admin")
  @@index([approvedByAdminId], map: "fk_account_expenses_approved_admin")
  @@index([createdAt], map: "idx_account_expenses_created")
  @@map("account_expenses")
}

model AccountExpenseItem {
  id                      BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  expenseId               BigInt               @map("expense_id") @db.UnsignedBigInt
  purpose                 String               @db.VarChar(190)
  costDate                DateTime             @map("cost_date") @db.Date
  quantity                Decimal              @db.Decimal(10, 2)
  perQtyAmount            Decimal              @map("per_qty_amount") @db.Decimal(12, 2)
  totalAmount             Decimal              @map("total_amount") @db.Decimal(12, 2)
  receiptStoredFileName   String?              @map("receipt_stored_file_name") @db.VarChar(255)
  receiptOriginalFileName String?              @map("receipt_original_file_name") @db.VarChar(255)
  receiptFileUrl          String?              @map("receipt_file_url") @db.VarChar(500)
  receiptFileSizeBytes    Int?                 @map("receipt_file_size_bytes") @db.UnsignedInt
  vendorId                BigInt?              @map("vendor_id") @db.UnsignedBigInt
  paymentStatus           VendorPaymentStatus? @map("payment_status")
  settlesItemId           BigInt?              @map("settles_item_id") @db.UnsignedBigInt
  settlesAllOwed          Boolean              @default(false) @map("settles_all_owed")
  createdAt               DateTime             @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt               DateTime             @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  expense AccountExpense @relation(fields: [expenseId], references: [id])
  vendor  Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  settlesItem    AccountExpenseItem?  @relation("ExpenseItemSettlement", fields: [settlesItemId], references: [id], onDelete: SetNull)
  settledByItems AccountExpenseItem[] @relation("ExpenseItemSettlement")

  @@index([expenseId], map: "fk_account_expense_items_expense")
  @@index([vendorId], map: "fk_account_expense_items_vendor")
  @@index([settlesItemId], map: "fk_account_expense_items_settles")
  @@map("account_expense_items")
}

model Vendor {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name         String   @db.VarChar(190)
  category     String?  @db.VarChar(100)
  contactName  String?  @map("contact_name") @db.VarChar(190)
  contactPhone String?  @map("contact_phone") @db.VarChar(50)
  contactEmail String?  @map("contact_email") @db.VarChar(190)
  notes        String?  @db.VarChar(500)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  balance      VendorBalance?
  expenseItems AccountExpenseItem[]

  @@map("vendors")
}

model VendorBalance {
  vendorId       BigInt   @id @map("vendor_id") @db.UnsignedBigInt
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(12, 2)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_balances")
}
